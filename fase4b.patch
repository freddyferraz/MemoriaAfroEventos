--- /dev/null
+++ b/TechFlow.Eventos.Api/wwwroot/js/cadastro.js
@@ -0,0 +1,36 @@
+/* Criar conta: o cadastro fica pendente até um moderador aprovar. */
+(function () {
+    const el = (id) => document.getElementById(id);
+
+    document.addEventListener("DOMContentLoaded", () => {
+        el("form-cadastro").addEventListener("submit", async (ev) => {
+            ev.preventDefault();
+            const erro = el("erro");
+            erro.textContent = "";
+
+            const nome = el("c-nome").value.trim();
+            const email = el("c-email").value.trim();
+            const senha = el("c-senha").value;
+            if (!nome || !email || !senha) { erro.textContent = "Preencha todos os campos marcados com asterisco."; return; }
+            if (senha !== el("c-senha2").value) { erro.textContent = "As senhas não conferem."; return; }
+            if (!el("c-aceite").checked) { erro.textContent = "Marque a caixa de concordância para criar a conta."; return; }
+
+            const botao = el("btn-cadastrar");
+            botao.disabled = true;
+            try {
+                const r = await Api.registrar({ nomeCompleto: nome, email, senha, aceiteTermos: true });
+                el("form-cadastro").hidden = true;
+                el("resultado").innerHTML = `
+                    <div class="msg-box">
+                        <h2>Cadastro recebido</h2>
+                        <p>${escapeHtml(r.mensagem)}</p>
+                        <p>Depois da aprovação, entre com o e-mail e a senha que você cadastrou.</p>
+                        <a class="btn btn-primary" href="index.html">Voltar ao início</a>
+                    </div>`;
+            } catch (e) {
+                erro.textContent = e.status === 429 ? "Muitas tentativas deste dispositivo. Tente novamente mais tarde." : e.message;
+                botao.disabled = false;
+            }
+        });
+    });
+})();
diff --git a/TechFlow.Eventos.Api/wwwroot/js/carrossel.js b/TechFlow.Eventos.Api/wwwroot/js/carrossel.js
new file mode 100644
index 0000000..fd4356a
--- /dev/null
+++ b/TechFlow.Eventos.Api/wwwroot/js/carrossel.js
@@ -0,0 +1,84 @@
+/* Carrossel: trilho horizontal com rolagem por toque, setas e rotação automática opcional.
+   Uso: <div class="carrossel" data-carrossel [data-autoplay="6000"]><div class="carrossel-trilho">...</div></div> */
+(function () {
+    const reduzido = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+    const comportamento = reduzido ? "auto" : "smooth";
+
+    function criarBotao(classe, simbolo, rotulo) {
+        const b = document.createElement("button");
+        b.type = "button";
+        b.className = `carrossel-btn ${classe}`;
+        b.textContent = simbolo;
+        b.setAttribute("aria-label", rotulo);
+        return b;
+    }
+
+    function iniciar(raiz) {
+        const trilho = raiz.querySelector(".carrossel-trilho");
+        if (!trilho || raiz.dataset.pronto) return;
+        raiz.dataset.pronto = "1";
+
+        raiz.setAttribute("role", "region");
+        raiz.setAttribute("aria-roledescription", "carrossel");
+        trilho.tabIndex = 0; // permite rolar com as setas do teclado
+        trilho.setAttribute("aria-label", raiz.getAttribute("aria-label") || "Lista de eventos");
+
+        const anterior = criarBotao("anterior", "‹", "Mostrar eventos anteriores");
+        const proximo = criarBotao("proximo", "›", "Mostrar próximos eventos");
+        raiz.append(anterior, proximo);
+
+        const passo = () => {
+            const filho = trilho.firstElementChild;
+            const gap = parseFloat(getComputedStyle(trilho).columnGap) || 16;
+            return filho ? filho.getBoundingClientRect().width + gap : trilho.clientWidth;
+        };
+        const noFim = () => trilho.scrollLeft + trilho.clientWidth >= trilho.scrollWidth - 2;
+
+        let pausaBtn = null;
+        function atualizar() {
+            const rolavel = trilho.scrollWidth > trilho.clientWidth + 2;
+            anterior.hidden = proximo.hidden = !rolavel;
+            if (pausaBtn) pausaBtn.hidden = !rolavel;
+            anterior.disabled = trilho.scrollLeft <= 2;
+            proximo.disabled = noFim();
+        }
+
+        anterior.addEventListener("click", () => trilho.scrollBy({ left: -passo(), behavior: comportamento }));
+        proximo.addEventListener("click", () => trilho.scrollBy({ left: passo(), behavior: comportamento }));
+        trilho.addEventListener("scroll", () => requestAnimationFrame(atualizar), { passive: true });
+        new ResizeObserver(atualizar).observe(trilho);
+        new MutationObserver(atualizar).observe(trilho, { childList: true });
+
+        // Rotação automática: opcional, com botão de pausa, e desligada para quem prefere menos movimento.
+        const intervalo = Number(raiz.dataset.autoplay) || 0;
+        if (intervalo && !reduzido) {
+            let pausado = false, interagindo = false, retomar;
+            pausaBtn = document.createElement("button");
+            pausaBtn.type = "button";
+            pausaBtn.className = "carrossel-pausa";
+            pausaBtn.textContent = "Pausar";
+            pausaBtn.setAttribute("aria-label", "Pausar a rotação automática dos eventos");
+            pausaBtn.addEventListener("click", () => {
+                pausado = !pausado;
+                pausaBtn.textContent = pausado ? "Continuar" : "Pausar";
+                pausaBtn.setAttribute("aria-label", pausado ? "Retomar a rotação automática dos eventos" : "Pausar a rotação automática dos eventos");
+            });
+            raiz.append(pausaBtn);
+
+            setInterval(() => {
+                if (pausado || interagindo || document.hidden || trilho.scrollWidth <= trilho.clientWidth + 2) return;
+                if (noFim()) trilho.scrollTo({ left: 0, behavior: comportamento });
+                else trilho.scrollBy({ left: passo(), behavior: comportamento });
+            }, intervalo);
+
+            ["mouseenter", "focusin"].forEach((e) => raiz.addEventListener(e, () => { interagindo = true; }));
+            ["mouseleave", "focusout"].forEach((e) => raiz.addEventListener(e, () => { interagindo = false; }));
+            raiz.addEventListener("touchstart", () => { interagindo = true; clearTimeout(retomar); }, { passive: true });
+            raiz.addEventListener("touchend", () => { retomar = setTimeout(() => { interagindo = false; }, 8000); }, { passive: true });
+        }
+
+        atualizar();
+    }
+
+    document.addEventListener("DOMContentLoaded", () => document.querySelectorAll("[data-carrossel]").forEach(iniciar));
+})();
