@@ -0,0 +1,34 @@
+using Microsoft.EntityFrameworkCore;
+using TechFlow.Eventos.Core.Newsletter;
+using TechFlow.Eventos.Infra.Data;
+
+namespace TechFlow.Eventos.Infra.Newsletter;
+
+public class AssinanteRepository : IAssinanteRepository
+{
+    private readonly AppDbContext _db;
+
+    public AssinanteRepository(AppDbContext db) => _db = db;
+
+    public Task<Assinante?> ObterPorEmailAsync(string email) => _db.Assinantes.FirstOrDefaultAsync(a => a.Email == email);
+
+    public Task<Assinante?> ObterPorTokenAsync(string token) => _db.Assinantes.FirstOrDefaultAsync(a => a.Token == token);
+
+    public async Task<IReadOnlyList<Assinante>> ListarConfirmadosAsync() =>
+        await _db.Assinantes.AsNoTracking().Where(a => a.Confirmado).ToListAsync();
+
+    public async Task<HashSet<int>> ListarIdsJaNotificadosAsync(int eventoId) =>
+        (await _db.EnviosNewsletter.Where(x => x.EventoId == eventoId).Select(x => x.AssinanteId).ToListAsync()).ToHashSet();
+
+    public async Task AdicionarAsync(Assinante assinante) => await _db.Assinantes.AddAsync(assinante);
+
+    public void Remover(Assinante assinante) => _db.Assinantes.Remove(assinante);
+
+    public async Task RegistrarEnvioAsync(int eventoId, int assinanteId)
+    {
+        _db.EnviosNewsletter.Add(new EnvioNewsletter { EventoId = eventoId, AssinanteId = assinanteId });
+        await _db.SaveChangesAsync();
+    }
+
+    public Task SalvarAlteracoesAsync() => _db.SaveChangesAsync();
+}
diff -ruN -x bin -x obj /tmp/antes3/TechFlow.Eventos.Infra/Newsletter/EmailSenders.cs TechFlowEventos/TechFlow.Eventos.Infra/Newsletter/EmailSenders.cs
--- /tmp/antes3/TechFlow.Eventos.Infra/Newsletter/EmailSenders.cs	1970-01-01 00:00:00.000000000 +0000
+++ TechFlowEventos/TechFlow.Eventos.Infra/Newsletter/EmailSenders.cs	2026-11-06 01:27:43.746255819 +0000
@@ -0,0 +1,63 @@
+using System.Net.Http.Json;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.Logging;
+using TechFlow.Eventos.Core.Newsletter;
+
+namespace TechFlow.Eventos.Infra.Newsletter;
+
+/// <summary>
+/// Envio pela API HTTP do Brevo (https://developers.brevo.com). Usa HTTPS (porta 443), então funciona
+/// no Render, que bloqueia SMTP (25, 465 e 587) nos serviços gratuitos. O remetente precisa estar verificado no Brevo.
+/// </summary>
+public class BrevoEmailSender : IEmailSender
+{
+    private readonly HttpClient _http;
+    private readonly NewsletterOptions _options;
+    private readonly string _apiKey;
+
+    public BrevoEmailSender(HttpClient http, NewsletterOptions options, IConfiguration configuration)
+    {
+        _http = http;
+        _options = options;
+        _apiKey = configuration["Email:Brevo:ApiKey"] ?? string.Empty;
+    }
+
+    public async Task EnviarAsync(EmailMensagem m, CancellationToken ct = default)
+    {
+        var payload = new
+        {
+            sender = new { name = _options.NomeRemetente, email = _options.EmailRemetente },
+            to = new[] { new { email = m.Para } },
+            subject = m.Assunto,
+            htmlContent = m.Html,
+            textContent = m.Texto
+        };
+
+        using var req = new HttpRequestMessage(HttpMethod.Post, "https://api.brevo.com/v3/smtp/email")
+        {
+            Content = JsonContent.Create(payload)
+        };
+        req.Headers.Add("api-key", _apiKey);
+
+        using var resp = await _http.SendAsync(req, ct);
+        if (!resp.IsSuccessStatusCode)
+        {
+            var corpo = await resp.Content.ReadAsStringAsync(ct);
+            throw new InvalidOperationException($"Brevo respondeu {(int)resp.StatusCode}: {(corpo.Length > 300 ? corpo[..300] : corpo)}");
+        }
+    }
+}
+
+/// <summary>Sem provedor configurado, o e-mail é apenas registrado no log (útil em desenvolvimento: os links aparecem no console).</summary>
+public class LogEmailSender : IEmailSender
+{
+    private readonly ILogger<LogEmailSender> _log;
+
+    public LogEmailSender(ILogger<LogEmailSender> log) => _log = log;
+
+    public Task EnviarAsync(EmailMensagem m, CancellationToken ct = default)
+    {
+        _log.LogWarning("E-mail NÃO enviado (provedor não configurado). Para: {Para} | Assunto: {Assunto}\n{Texto}", m.Para, m.Assunto, m.Texto);
+        return Task.CompletedTask;
+    }
+}
diff -ruN -x bin -x obj /tmp/antes3/TechFlow.Eventos.Infra/Newsletter/NewsletterModelConfig.cs TechFlowEventos/TechFlow.Eventos.Infra/Newsletter/NewsletterModelConfig.cs
--- /tmp/antes3/TechFlow.Eventos.Infra/Newsletter/NewsletterModelConfig.cs	1970-01-01 00:00:00.000000000 +0000
+++ TechFlowEventos/TechFlow.Eventos.Infra/Newsletter/NewsletterModelConfig.cs	2026-11-06 01:27:43.744979622 +0000
@@ -0,0 +1,27 @@
+using Microsoft.EntityFrameworkCore;
+using TechFlow.Eventos.Core.Models;
+using TechFlow.Eventos.Core.Newsletter;
+
+namespace TechFlow.Eventos.Infra.Newsletter;
+
+/// <summary>Mapeamento das tabelas do módulo, chamado de uma linha no AppDbContext.</summary>
+public static class NewsletterModelConfig
+{
+    public static void Aplicar(ModelBuilder b)
+    {
+        b.Entity<Assinante>(a =>
+        {
+            a.Property(x => x.Email).HasMaxLength(254).IsRequired();
+            a.HasIndex(x => x.Email).IsUnique();
+            a.Property(x => x.Token).HasMaxLength(64).IsRequired();
+            a.HasIndex(x => x.Token).IsUnique();
+        });
+
+        b.Entity<EnvioNewsletter>(e =>
+        {
+            e.HasOne<Assinante>().WithMany().HasForeignKey(x => x.AssinanteId).OnDelete(DeleteBehavior.Cascade);
+            e.HasOne<Evento>().WithMany().HasForeignKey(x => x.EventoId).OnDelete(DeleteBehavior.Cascade);
+            e.HasIndex(x => new { x.EventoId, x.AssinanteId }).IsUnique();
+        });
+    }
+}
diff -ruN -x bin -x obj /tmp/antes3/TechFlow.Eventos.Infra/Newsletter/NewsletterModule.cs TechFlowEventos/TechFlow.Eventos.Infra/Newsletter/NewsletterModule.cs
--- /tmp/antes3/TechFlow.Eventos.Infra/Newsletter/NewsletterModule.cs	1970-01-01 00:00:00.000000000 +0000
+++ TechFlowEventos/TechFlow.Eventos.Infra/Newsletter/NewsletterModule.cs	2026-11-06 01:27:43.748203653 +0000
@@ -0,0 +1,43 @@
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using TechFlow.Eventos.Core.Interfaces;
+using TechFlow.Eventos.Core.Newsletter;
+
+namespace TechFlow.Eventos.Infra.Newsletter;
+
+public static class NewsletterModule
+{
+    /// <summary>
+    /// Registra o módulo Newsletter. Configuração: App:BaseUrl, Email:RemetenteNome, Email:RemetenteEmail e Email:Brevo:ApiKey.
+    /// Sem ApiKey e remetente, usa o LogEmailSender (nada é enviado de verdade).
+    /// </summary>
+    public static IServiceCollection AddNewsletterModule(this IServiceCollection services, IConfiguration config)
+    {
+        var options = new NewsletterOptions
+        {
+            BaseUrl = config["App:BaseUrl"] ?? string.Empty,
+            NomeRemetente = config["Email:RemetenteNome"] ?? "TechFlow Eventos",
+            EmailRemetente = config["Email:RemetenteEmail"] ?? string.Empty
+        };
+        services.AddSingleton(options);
+
+        services.AddScoped<IAssinanteRepository, AssinanteRepository>();
+        services.AddScoped<NewsletterService>();
+
+        services.AddSingleton<NewsletterQueue>();
+        services.AddSingleton<INewsletterDispatcher>(sp => sp.GetRequiredService<NewsletterQueue>());
+        services.AddHostedService<NewsletterWorker>();
+        services.AddScoped<IEventoPublicadoHandler, NewsletterEventoPublicadoHandler>();
+
+        if (!string.IsNullOrWhiteSpace(config["Email:Brevo:ApiKey"]) && !string.IsNullOrWhiteSpace(options.EmailRemetente))
+        {
+            services.AddHttpClient<IEmailSender, BrevoEmailSender>(c => c.Timeout = TimeSpan.FromSeconds(15));
+        }
+        else
+        {
+            services.AddSingleton<IEmailSender, LogEmailSender>();
+        }
+
+        return services;
+    }
+}
diff -ruN -x bin -x obj /tmp/antes3/TechFlow.Eventos.Infra/Newsletter/NewsletterWorker.cs TechFlowEventos/TechFlow.Eventos.Infra/Newsletter/NewsletterWorker.cs
--- /tmp/antes3/TechFlow.Eventos.Infra/Newsletter/NewsletterWorker.cs	1970-01-01 00:00:00.000000000 +0000
+++ TechFlowEventos/TechFlow.Eventos.Infra/Newsletter/NewsletterWorker.cs	2026-11-06 01:27:43.746895630 +0000
@@ -0,0 +1,74 @@
+using System.Threading.Channels;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Hosting;
+using Microsoft.Extensions.Logging;
+using TechFlow.Eventos.Core.Interfaces;
+using TechFlow.Eventos.Core.Models;
+using TechFlow.Eventos.Core.Newsletter;
+
+namespace TechFlow.Eventos.Infra.Newsletter;
+
+/// <summary>Fila em memória de eventos a notificar. Se a aplicação reiniciar com itens na fila, eles se perdem (limitação do MVP).</summary>
+public sealed class NewsletterQueue : INewsletterDispatcher
+{
+    private readonly Channel<int> _canal = Channel.CreateUnbounded<int>();
+
+    public void EnfileirarEvento(int eventoId) => _canal.Writer.TryWrite(eventoId);
+
+    public IAsyncEnumerable<int> LerAsync(CancellationToken ct) => _canal.Reader.ReadAllAsync(ct);
+}
+
+/// <summary>Processa a fila em segundo plano, fora da requisição de moderação.</summary>
+public class NewsletterWorker : BackgroundService
+{
+    private readonly NewsletterQueue _fila;
+    private readonly IServiceScopeFactory _scopes;
+    private readonly ILogger<NewsletterWorker> _log;
+
+    public NewsletterWorker(NewsletterQueue fila, IServiceScopeFactory scopes, ILogger<NewsletterWorker> log)
+    {
+        _fila = fila;
+        _scopes = scopes;
+        _log = log;
+    }
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        try
+        {
+            await foreach (var eventoId in _fila.LerAsync(stoppingToken))
+            {
+                try
+                {
+                    using var scope = _scopes.CreateScope();
+                    var servico = scope.ServiceProvider.GetRequiredService<NewsletterService>();
+                    var r = await servico.NotificarEventoAsync(eventoId, stoppingToken);
+                    _log.LogInformation("Newsletter do evento {Id}: {Enviados}/{Destinatarios} enviados, {Falhas} falhas. {Erro}",
+                        eventoId, r.Enviados, r.Destinatarios, r.Falhas, r.UltimoErro);
+                }
+                catch (Exception ex) when (ex is not OperationCanceledException)
+                {
+                    _log.LogError(ex, "Falha ao processar a newsletter do evento {Id}.", eventoId);
+                }
+            }
+        }
+        catch (OperationCanceledException)
+        {
+            // desligamento da aplicação
+        }
+    }
+}
+
+/// <summary>Liga o módulo de Eventos ao de Newsletter: ao aprovar um evento, ele entra na fila.</summary>
+public class NewsletterEventoPublicadoHandler : IEventoPublicadoHandler
+{
+    private readonly INewsletterDispatcher _dispatcher;
+
+    public NewsletterEventoPublicadoHandler(INewsletterDispatcher dispatcher) => _dispatcher = dispatcher;
+
+    public Task AoPublicarAsync(Evento evento, CancellationToken ct = default)
+    {
+        _dispatcher.EnfileirarEvento(evento.Id);
+        return Task.CompletedTask;
+    }
+}
