diff -ruN -x bin -x obj /tmp/antes3/TechFlow.Eventos.Infra/Newsletter/AssinanteRepository.cs TechFlowEventos/TechFlow.Eventos.Infra/Newsletter/AssinanteRepository.cs
--- /tmp/antes3/TechFlow.Eventos.Infra/Newsletter/AssinanteRepository.cs	1970-01-01 00:00:00.000000000 +0000
