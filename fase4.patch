diff --git a/TechFlow.Eventos.Api/wwwroot/js/interesses.js b/TechFlow.Eventos.Api/wwwroot/js/interesses.js
new file mode 100644
index 0000000..dfab6ae
--- /dev/null
+++ b/TechFlow.Eventos.Api/wwwroot/js/interesses.js
@@ -0,0 +1,53 @@
+/* Interesses do visitante.
+   Ficam apenas neste navegador (localStorage). O servidor recebe o perfil só para calcular as sugestões e não o guarda. */
+const Interesses = (() => {
+    const CHAVE = "cc.interesses";
+    const PESO_ESCOLHA = 5; // categoria ou cidade marcada pela própria pessoa vale mais que um clique
+
+    const vazio = () => ({ vistas: {}, cidadesVistas: {}, escolhidas: { categorias: [], cidades: [] } });
+
+    function ler() {
+        try {
+            const p = JSON.parse(localStorage.getItem(CHAVE) || "{}");
+            return { ...vazio(), ...p, escolhidas: { ...vazio().escolhidas, ...(p.escolhidas || {}) } };
+        } catch { return vazio(); }
+    }
+
+    function gravar(p) {
+        try { localStorage.setItem(CHAVE, JSON.stringify(p)); } catch { /* armazenamento indisponível */ }
+    }
+
+    return {
+        /** Perfil no formato esperado pela API de recomendações. */
+        perfil() {
+            const p = ler();
+            const pesos = { ...p.vistas };
+            p.escolhidas.categorias.forEach((c) => { pesos[c] = (pesos[c] || 0) + PESO_ESCOLHA; });
+            const cidades = new Set(p.escolhidas.cidades);
+            Object.entries(p.cidadesVistas).forEach(([c, n]) => { if (n >= 2) cidades.add(c); });
+            return {
+                categorias: Object.entries(pesos).map(([categoria, peso]) => ({ categoria: Number(categoria), peso })),
+                cidades: [...cidades],
+            };
+        },
+        /** Registra um sinal de interesse (abrir o evento = 1, adicionar à agenda = 2, boa avaliação = 2). */
+        registrar(evento, peso = 1) {
+            if (!evento || peso <= 0) return;
+            const p = ler();
+            p.vistas[evento.categoria] = (p.vistas[evento.categoria] || 0) + peso;
+            p.cidadesVistas[evento.cidade] = (p.cidadesVistas[evento.cidade] || 0) + peso;
+            gravar(p);
+        },
+        escolhidas: () => ler().escolhidas,
+        definir(categorias, cidades) {
+            const p = ler();
+            p.escolhidas = { categorias: categorias.map(Number), cidades };
+            gravar(p);
+        },
+        limpar() { gravar(vazio()); },
+        temInteresses() {
+            const { categorias, cidades } = this.perfil();
+            return categorias.length > 0 || cidades.length > 0;
+        },
+    };
+})();
diff --git a/TechFlow.Eventos.Api/wwwroot/js/moderar-avaliacoes.js b/TechFlow.Eventos.Api/wwwroot/js/moderar-avaliacoes.js
