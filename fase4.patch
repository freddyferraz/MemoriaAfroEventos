+using System.Globalization;
+using TechFlow.Eventos.Core.Models;
+
+namespace TechFlow.Eventos.Core.Calendario;
+
+/// <summary>Links "adicionar à agenda" para os calendários na web (o .ics cobre Apple e demais aplicativos).</summary>
+public static class CalendarioLinks
+{
+    public static string Google(Evento e, string urlEvento)
+    {
+        var datas = $"{IcsBuilder.Formatar(IcsBuilder.InicioUtc(e))}/{IcsBuilder.Formatar(IcsBuilder.FimUtc(e))}";
+        return "https://calendar.google.com/calendar/render?action=TEMPLATE"
+            + $"&text={Uri.EscapeDataString(e.Titulo)}"
+            + $"&dates={datas}"
+            + $"&details={Uri.EscapeDataString(Detalhes(e, urlEvento))}"
+            + $"&location={Uri.EscapeDataString(Local(e))}";
+    }
+
+    public static string OutlookPessoal(Evento e, string urlEvento) => Outlook("https://outlook.live.com", e, urlEvento);
+
+    public static string Microsoft365(Evento e, string urlEvento) => Outlook("https://outlook.office.com", e, urlEvento);
+
+    private static string Outlook(string host, Evento e, string urlEvento) =>
+        $"{host}/calendar/0/deeplink/compose?path=%2Fcalendar%2Faction%2Fcompose&rru=addevent"
+        + $"&subject={Uri.EscapeDataString(e.Titulo)}"
+        + $"&startdt={Uri.EscapeDataString(IcsBuilder.InicioUtc(e).ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", CultureInfo.InvariantCulture))}"
+        + $"&enddt={Uri.EscapeDataString(IcsBuilder.FimUtc(e).ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", CultureInfo.InvariantCulture))}"
+        + $"&body={Uri.EscapeDataString(Detalhes(e, urlEvento))}"
+        + $"&location={Uri.EscapeDataString(Local(e))}";
+
+    private static string Local(Evento e) => $"{e.Endereco}, {e.Cidade}";
+
+    private static string Detalhes(Evento e, string urlEvento) =>
+        string.IsNullOrWhiteSpace(e.Atracoes) ? urlEvento : $"{e.Atracoes}\n\nMais informações: {urlEvento}";
+}
diff --git a/TechFlow.Eventos.Core/Calendario/IcsBuilder.cs b/TechFlow.Eventos.Core/Calendario/IcsBuilder.cs
new file mode 100644
index 0000000..655cc5e
--- /dev/null
+++ b/TechFlow.Eventos.Core/Calendario/IcsBuilder.cs
@@ -0,0 +1,109 @@
+using System.Globalization;
+using System.Text;
+using TechFlow.Eventos.Core.Models;
+
+namespace TechFlow.Eventos.Core.Calendario;
+
+/// <summary>
+/// Gera arquivos iCalendar (.ics, RFC 5545), aceitos por Google Calendar, Apple Calendar, Outlook e outros.
+/// Os horários dos eventos são de Brasília (UTC-3, sem horário de verão desde 2019) e saem convertidos para UTC.
+/// </summary>
+public static class IcsBuilder
+{
+    /// <summary>O cadastro não tem horário de término; usamos esta duração padrão.</summary>
+    public static readonly TimeSpan DuracaoPadrao = TimeSpan.FromHours(2);
+
+    private const string Crlf = "\r\n";
+
+    public static DateTime InicioUtc(Evento e) =>
+        new DateTime(e.Data.Year, e.Data.Month, e.Data.Day, e.Horario.Hour, e.Horario.Minute, 0, DateTimeKind.Utc).AddHours(3);
+
+    public static DateTime FimUtc(Evento e) => InicioUtc(e).Add(DuracaoPadrao);
+
+    public static string UmEvento(Evento e, string baseUrl) => Montar("Conecta Cultura", new[] { e }, baseUrl, incluirNomeCalendario: false);
+
+    public static string Feed(IEnumerable<Evento> eventos, string baseUrl, string nomeCalendario) =>
+        Montar(nomeCalendario, eventos, baseUrl, incluirNomeCalendario: true);
+
+    private static string Montar(string nome, IEnumerable<Evento> eventos, string baseUrl, bool incluirNomeCalendario)
+    {
+        var linhas = new List<string>
+        {
+            "BEGIN:VCALENDAR",
+            "VERSION:2.0",
+            "PRODID:-//Conecta Cultura//Agenda de Eventos//PT-BR",
+            "CALSCALE:GREGORIAN",
+            "METHOD:PUBLISH"
+        };
+
+        if (incluirNomeCalendario)
+        {
+            linhas.Add("X-WR-CALNAME:" + Escapar(nome));
+            linhas.Add("X-WR-TIMEZONE:America/Sao_Paulo");
+        }
+
+        var agora = DateTime.UtcNow;
+        foreach (var e in eventos)
+        {
+            var url = $"{baseUrl.TrimEnd('/')}/evento.html?id={e.Id}";
+            var descricao = string.IsNullOrWhiteSpace(e.Atracoes) ? url : $"{e.Atracoes}\n\nMais informações: {url}";
+
+            linhas.Add("BEGIN:VEVENT");
+            linhas.Add($"UID:evento-{e.Id}@conectacultura");
+            linhas.Add("DTSTAMP:" + Formatar(agora));
+            linhas.Add("DTSTART:" + Formatar(InicioUtc(e)));
+            linhas.Add("DTEND:" + Formatar(FimUtc(e)));
+            linhas.Add("SUMMARY:" + Escapar(e.Titulo));
+            linhas.Add("LOCATION:" + Escapar($"{e.Endereco}, {e.Cidade}"));
+            linhas.Add("DESCRIPTION:" + Escapar(descricao));
+            linhas.Add("URL:" + url);
+            linhas.Add("STATUS:CONFIRMED");
+            linhas.Add("BEGIN:VALARM");
+            linhas.Add("TRIGGER:-PT1H");
+            linhas.Add("ACTION:DISPLAY");
+            linhas.Add("DESCRIPTION:" + Escapar("Lembrete: " + e.Titulo));
+            linhas.Add("END:VALARM");
+            linhas.Add("END:VEVENT");
+        }
+
+        linhas.Add("END:VCALENDAR");
+        return string.Concat(linhas.SelectMany(Dobrar).Select(l => l + Crlf));
+    }
+
+    public static string Formatar(DateTime utc) => utc.ToString("yyyyMMdd'T'HHmmss'Z'", CultureInfo.InvariantCulture);
+
+    /// <summary>Escape de texto do iCalendar: barra invertida, ponto e vírgula, vírgula e quebras de linha.</summary>
+    public static string Escapar(string texto) =>
+        texto.Replace("\\", "\\\\").Replace(";", "\\;").Replace(",", "\\,")
+             .Replace("\r\n", "\\n").Replace("\n", "\\n").Replace("\r", "\\n");
+
+    /// <summary>Linhas do iCalendar têm no máximo 75 bytes; o excedente continua na linha seguinte iniciada por um espaço.</summary>
+    internal static IEnumerable<string> Dobrar(string linha)
+    {
+        if (Encoding.UTF8.GetByteCount(linha) <= 75)
+        {
+            yield return linha;
+            yield break;
+        }
+
+        var atual = new StringBuilder();
+        var bytes = 0;
+        var limite = 75;
+        foreach (var rune in linha.EnumerateRunes())
+        {
+            var tamanho = rune.Utf8SequenceLength;
+            if (bytes + tamanho > limite)
+            {
+                yield return atual.ToString();
+                atual.Clear().Append(' ');
+                bytes = 1;
+                limite = 75;
+            }
+
+            atual.Append(rune.ToString());
+            bytes += tamanho;
+        }
+
+        if (atual.Length > 0) yield return atual.ToString();
+    }
+}
diff --git a/TechFlow.Eventos.Core/Recomendacoes/RecomendacaoService.cs b/TechFlow.Eventos.Core/Recomendacoes/RecomendacaoService.cs
new file mode 100644
index 0000000..2f1ff37
--- /dev/null
+++ b/TechFlow.Eventos.Core/Recomendacoes/RecomendacaoService.cs
@@ -0,0 +1,87 @@
+using TechFlow.Eventos.Core.Enums;
+using TechFlow.Eventos.Core.Interfaces;
+using TechFlow.Eventos.Core.Models;
+
+namespace TechFlow.Eventos.Core.Recomendacoes;
+
+public record PesoCategoria(int Categoria, double Peso);
+
+/// <summary>Interesses informados pelo próprio navegador do visitante. O servidor não guarda este perfil.</summary>
+public record PerfilInteresses(IReadOnlyList<PesoCategoria> Categorias, IReadOnlyList<string> Cidades)
+{
+    public static PerfilInteresses Vazio { get; } = new(Array.Empty<PesoCategoria>(), Array.Empty<string>());
+
+    public bool EstaVazio => Categorias.Count == 0 && Cidades.Count == 0;
+}
+
+public record EventoRecomendado(Evento Evento, double Pontos, string Motivo);
+
+/// <summary>
+/// Recomendação por pontuação simples e explicável: categoria de interesse (peso relativo), cidade de interesse,
+/// destaque e proximidade da data. Sem perfil, devolve os eventos em destaque e os mais próximos.
+/// </summary>
+public class RecomendacaoService
+{
+    private readonly IEventoRepository _eventos;
+
+    public RecomendacaoService(IEventoRepository eventos) => _eventos = eventos;
+
+    public async Task<IReadOnlyList<EventoRecomendado>> RecomendarAsync(PerfilInteresses perfil, IEnumerable<int> excluirIds, int limite)
+    {
+        var excluir = excluirIds.ToHashSet();
+        var candidatos = (await _eventos.BuscarAprovadosAsync(new EventoFiltro())).Where(e => !excluir.Contains(e.Id));
+        var hoje = Evento.HojeBrasil();
+        var maiorPeso = perfil.Categorias.Count == 0 ? 1 : Math.Max(perfil.Categorias.Max(c => c.Peso), 0.0001);
+
+        return candidatos
+            .Select(e =>
+            {
+                var peso = perfil.Categorias.Where(c => c.Categoria == (int)e.Categoria).Select(c => c.Peso).DefaultIfEmpty(0).Max();
+                var pontosCategoria = peso <= 0 ? 0 : 5 * Math.Min(peso / maiorPeso, 1);
+                var cidadeCombina = perfil.Cidades.Any(c => string.Equals(c, e.Cidade, StringComparison.OrdinalIgnoreCase));
+                var pontos = pontosCategoria + (cidadeCombina ? 2 : 0) + (e.Destaque ? 0.5 : 0) + Proximidade(e, hoje);
+
+                var motivo = pontosCategoria > 0 ? $"Porque você se interessa por {e.Categoria.Nome().ToLowerInvariant()}"
+                    : cidadeCombina ? $"Perto de você: {e.Cidade}"
+                    : e.Destaque ? "Em destaque"
+                    : "Acontece em breve";
+
+                return new EventoRecomendado(e, pontos, motivo);
+            })
+            .OrderByDescending(r => r.Pontos).ThenBy(r => r.Evento.Data).ThenBy(r => r.Evento.Horario)
+            .Take(Math.Clamp(limite, 1, 12))
+            .ToList();
+    }
+
+    /// <summary>Eventos parecidos com um evento específico: mesma categoria, mesma cidade e datas próximas.</summary>
+    public async Task<IReadOnlyList<EventoRecomendado>> SimilaresAsync(int eventoId, int limite)
+    {
+        var baseEvento = await _eventos.ObterPorIdAsync(eventoId);
+        if (baseEvento is null) return Array.Empty<EventoRecomendado>();
+
+        var hoje = Evento.HojeBrasil();
+        return (await _eventos.BuscarAprovadosAsync(new EventoFiltro()))
+            .Where(e => e.Id != eventoId)
+            .Select(e =>
+            {
+                var mesmaCategoria = e.Categoria == baseEvento.Categoria;
+                var mesmaCidade = string.Equals(e.Cidade, baseEvento.Cidade, StringComparison.OrdinalIgnoreCase);
+                var pontos = (mesmaCategoria ? 4 : 0) + (mesmaCidade ? 2 : 0) + Proximidade(e, hoje);
+                var motivo = mesmaCategoria && mesmaCidade ? $"{e.Categoria.Nome()} em {e.Cidade}"
+                    : mesmaCategoria ? $"Mais de {e.Categoria.Nome().ToLowerInvariant()}"
+                    : mesmaCidade ? $"Também em {e.Cidade}"
+                    : "Acontece em breve";
+                return new EventoRecomendado(e, pontos, motivo);
+            })
+            .Where(r => r.Pontos >= 2)
+            .OrderByDescending(r => r.Pontos).ThenBy(r => r.Evento.Data)
+            .Take(Math.Clamp(limite, 1, 12))
+            .ToList();
+    }
+
+    private static double Proximidade(Evento e, DateOnly hoje)
+    {
+        var dias = e.Data.DayNumber - hoje.DayNumber;
+        return dias <= 7 ? 1.5 : dias <= 30 ? 0.75 : 0;
+    }
+}
