@@ -0,0 +1,44 @@
+/* Moderação de comentários (Admin/Moderador). */
+(function () {
+    const estrelas = (n) => "★".repeat(n) + "☆".repeat(5 - n);
+
+    async function carregar() {
+        const alvo = document.getElementById("pendentes-avaliacoes");
+        if (!alvo || !Session.obter()) return;
+        try {
+            const lista = await Api.listarAvaliacoesPendentes();
+            if (!lista.length) { alvo.innerHTML = EventosUI.vazio("Nenhum comentário aguardando revisão."); return; }
+            alvo.innerHTML = lista.map((a) => `
+                <div class="mod-item" data-id="${a.id}">
+                    <div>
+                        <h3 style="margin-bottom:4px">${escapeHtml(a.eventoTitulo)}</h3>
+                        <div class="ev-meta"><span class="estrela" role="img" aria-label="Nota ${a.nota} de 5">${estrelas(a.nota)}</span> por ${escapeHtml(a.nome)}</div>
+                        <p style="margin:8px 0 0;white-space:pre-line">${escapeHtml(a.comentario)}</p>
+                    </div>
+                    <div class="mod-acoes">
+                        <button class="btn btn-primary btn-small" data-aprovar="1">Aprovar</button>
+                        <button class="btn btn-small btn-perigo" data-aprovar="0">Rejeitar</button>
+                    </div>
+                </div>`).join("");
+        } catch (e) {
+            alvo.innerHTML = EventosUI.vazio(e.status === 403 ? "Esta conta não tem permissão de moderador." : escapeHtml(e.message));
+        }
+    }
+
+    document.addEventListener("DOMContentLoaded", () => {
+        carregar();
+        document.getElementById("pendentes-avaliacoes")?.addEventListener("click", async (ev) => {
+            const botao = ev.target.closest("[data-aprovar]");
+            if (!botao) return;
+            botao.disabled = true;
+            try {
+                await Api.moderarAvaliacao(botao.closest(".mod-item").dataset.id, botao.dataset.aprovar === "1");
+                mostrarToast(botao.dataset.aprovar === "1" ? "Comentário publicado." : "Comentário rejeitado.");
+                carregar();
+            } catch (e) {
+                mostrarToast(e.message, "erro");
+                botao.disabled = false;
+            }
+        });
+    });
+})();
diff --git a/TechFlow.Eventos.Api/wwwroot/js/recomendacoes.js b/TechFlow.Eventos.Api/wwwroot/js/recomendacoes.js
new file mode 100644
index 0000000..d281017
--- /dev/null
+++ b/TechFlow.Eventos.Api/wwwroot/js/recomendacoes.js
@@ -0,0 +1,80 @@
+/* Recomendações: "Recomendado para você" (início) e "Você também pode gostar" (detalhes do evento). */
+(function () {
+    const q = (id) => document.getElementById(id);
+
+    function cartao(e) {
+        return `<div>${EventosUI.card(e)}<p class="rec-motivo">${escapeHtml(e.motivo)}</p></div>`;
+    }
+
+    // ---------- Início ----------
+    async function carregarParaVoce() {
+        const grade = q("para-voce-grid");
+        const perfil = Interesses.perfil();
+        q("para-voce-info").textContent = Interesses.temInteresses()
+            ? "Com base nos eventos que você abriu e nos interesses escolhidos neste navegador."
+            : "Escolha seus interesses para receber sugestões. Enquanto isso, mostramos os destaques e o que acontece em breve.";
+        try {
+            const itens = await Api.recomendar({ categorias: perfil.categorias, cidades: perfil.cidades, limite: 6 });
+            grade.innerHTML = itens.length
+                ? itens.map(cartao).join("")
+                : EventosUI.vazio("Ainda não há eventos para sugerir.");
+        } catch {
+            grade.innerHTML = EventosUI.vazio("Não foi possível carregar as sugestões.");
+        }
+    }
+
+    function desenharChips(categorias) {
+        const e = Interesses.escolhidas();
+        const nomes = e.categorias.map((id) => categorias.find((c) => c.id === id)?.nome).filter(Boolean).concat(e.cidades);
+        q("para-voce-chips").innerHTML = nomes.map((n) => `<span class="chip">${escapeHtml(n)}</span>`).join("");
+    }
+
+    async function montarPainel() {
+        let categorias = [], cidades = [];
+        try { [categorias, cidades] = await Promise.all([Api.listarCategoriasEvento(), Api.listarCidadesEvento()]); } catch { /* painel fica vazio */ }
+        const marcadas = Interesses.escolhidas();
+
+        q("int-categorias").innerHTML = categorias.map((c) =>
+            `<label><input type="checkbox" value="${c.id}" ${marcadas.categorias.includes(c.id) ? "checked" : ""} /> ${escapeHtml(c.nome)}</label>`).join("");
+        if (cidades.length) {
+            q("int-cidades").innerHTML = cidades.map((c) =>
+                `<label><input type="checkbox" value="${escapeHtml(c)}" ${marcadas.cidades.includes(c) ? "checked" : ""} /> ${escapeHtml(c)}</label>`).join("");
+            q("int-bloco-cidades").hidden = false;
+        }
+        desenharChips(categorias);
+
+        q("int-salvar").addEventListener("click", () => {
+            const marcados = (id) => [...q(id).querySelectorAll("input:checked")].map((i) => i.value);
+            Interesses.definir(marcados("int-categorias"), marcados("int-cidades"));
+            desenharChips(categorias);
+            q("painel-interesses").open = false;
+            mostrarToast("Interesses salvos neste navegador.");
+            carregarParaVoce();
+        });
+        q("int-limpar").addEventListener("click", () => {
+            Interesses.limpar();
+            q("painel-interesses").querySelectorAll("input").forEach((i) => { i.checked = false; });
+            desenharChips(categorias);
+            mostrarToast("Interesses apagados deste navegador.");
+            carregarParaVoce();
+        });
+    }
+
+    // ---------- Detalhes do evento ----------
+    document.addEventListener("evento-carregado", async (ev) => {
+        const e = ev.detail;
+        Interesses.registrar(e, 1);
+
+        const alvo = q("extra-similares");
+        if (!alvo) return;
+        try {
+            const itens = await Api.eventosSimilares(e.id, 4);
+            if (!itens.length) return;
+            alvo.innerHTML = `<section class="extra"><h2>Você também pode gostar</h2><div class="ev-grid">${itens.map(cartao).join("")}</div></section>`;
+        } catch { /* a seção simplesmente não aparece */ }
+    });
+
+    document.addEventListener("DOMContentLoaded", () => {
+        if (q("para-voce")) { carregarParaVoce(); montarPainel(); }
+    });
+})();
