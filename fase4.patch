@@ -37,10 +37,45 @@ const EventosUI = {
             <h3>${escapeHtml(e.titulo)}</h3>
             <span class="tag">${escapeHtml(e.categoriaNome)}</span>
             <span class="tag ${e.gratuito ? "gratis" : ""}">${this.preco(e)}</span>
